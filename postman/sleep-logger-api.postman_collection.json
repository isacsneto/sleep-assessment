{
  "info": {
    "name": "Sleep Logger API",
    "description": "Endpoints for the Noom sleep logger take-home. Set the `baseUrl` and `userId` collection variables as needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "Create sleep log",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inBedStart\": \"2026-09-01T22:53:00\",\n  \"inBedEnd\": \"2026-09-02T07:05:00\",\n  \"morningFeeling\": \"GOOD\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/sleep-logs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sleep-logs"]
        },
        "description": "REQ #1: create last night's sleep log. `sleepDate` is optional and defaults to the bedtime date."
      }
    },
    {
      "name": "Get last night's sleep",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sleep-logs/last-night",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sleep-logs", "last-night"]
        },
        "description": "REQ #1B: fetch the most recent sleep log for the user."
      }
    },
    {
      "name": "Get 30-day averages",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sleep-logs/averages?days=30",
          "host": ["{{baseUrl}}"],
          "path": ["api", "sleep-logs", "averages"],
          "query": [
            { "key": "days", "value": "30" }
          ]
        },
        "description": "REQ #3: averages over the last N days (defaults to 30)."
      }
    }
  ]
}
